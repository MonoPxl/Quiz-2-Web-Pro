# myITS Broadcast — JSP application configuration
#
# Copy this file to .env.jsp (git-ignored) and fill in real values.
# The JSP application reads configuration from environment variables only.
#
# The legacy Laravel application keeps its own .env file. This template uses a
# separate name so the two runtimes cannot overwrite or misread each other's
# settings (Laravel also defines APP_ENV, APP_KEY, DB_*, and so on).

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | production
APP_ENV=development

# Public base URL of the application, used for absolute links and redirects.
APP_BASE_URL=http://localhost:8080

# Absolute path where uploaded avatars and post covers are stored.
# Must be writable by the Tomcat process and outside the build directory.
APP_STORAGE_DIR=C:/myitsbroadcast-storage

# ---------------------------------------------------------------------------
# PostgreSQL (JDBC)
# ---------------------------------------------------------------------------
# JDBC URL for the application database. Port 5432 is the PostgreSQL default;
# use 5433 if your instance listens elsewhere.
DB_URL=jdbc:postgresql://localhost:5432/myitsbroadcast
DB_USER=myitsbroadcast_app
DB_PASSWORD=replace-with-a-strong-password

# Connection pool size (optional).
DB_POOL_SIZE=10

# ---------------------------------------------------------------------------
# Login throttling
# ---------------------------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60
